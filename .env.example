# ────────────────────────────────────────────────────────────────────────────
# LeadForge — environment configuration
#
# Copy this file to `.env` and fill in what you have. LeadForge is designed to
# run in development with NONE of the optional keys set — Lead Finder falls
# back to OpenStreetMap (free, no key), the website auditor falls back to its
# built-in heuristic scan, and AI features fall back to rule-based logic. You
# will just see fewer/lower-fidelity results until you add real keys.
# ────────────────────────────────────────────────────────────────────────────

# ── Database (required) ───────────────────────────────────────────────────
# Any PostgreSQL connection string works — a local Postgres, or a hosted
# instance such as Supabase (Project Settings → Database → Connection string).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadforge_dev"

# ── Auth (required) ────────────────────────────────────────────────────────
# Session signing secret for Auth.js. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ── Google Places API (optional, recommended) ──────────────────────────────
# Powers richer business search: verified phone numbers, opening hours,
# Google ratings/review counts, and Google Maps links.
# Get a key: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Enable the "Places API" (legacy) for your project and restrict the key to it.
GOOGLE_PLACES_API_KEY=""

# ── Google PageSpeed Insights (optional) ────────────────────────────────────
# Powers real Lighthouse performance/accessibility/SEO scores in the Website
# Auditor. Without it, LeadForge still runs a built-in heuristic HTTP/HTML
# audit (SSL, mobile viewport, SEO tags, CTAs, forms, load time, etc).
# Get a key: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=""

# ── Anthropic (optional, recommended for AI features) ───────────────────────
# Powers AI-generated sales angles, cold-call scripts and objection handling.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ── OpenAI (optional alternative AI provider) ───────────────────────────────
# Used automatically if ANTHROPIC_API_KEY is not set.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# ── Not needed ───────────────────────────────────────────────────────────
# The Lead Map uses OpenStreetMap tiles via Leaflet, which requires no API
# key. A GOOGLE_MAPS_API_KEY variable is intentionally not listed here —
# it isn't wired to anything, and this app never ships an unused integration.
